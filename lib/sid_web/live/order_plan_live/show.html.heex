<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-6xl space-y-10 px-4 py-8 sm:px-6 lg:px-8">
    <header class="space-y-6">
      <.link
        navigate={~p"/"}
        class="inline-flex items-center gap-2 text-sm font-medium text-base-content/70 transition-colors hover:text-primary"
      >
        ← All order plans
      </.link>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
          Order Plan
        </p>

        <h1 class="mt-2 text-3xl font-bold tracking-tight text-base-content">
          {@order_plan.name}
        </h1>
      </div>
    </header>

    <section
      aria-label="Budget overview"
      class="grid gap-4 sm:grid-cols-3"
    >
      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-base-content/60">
          Budget
        </p>

        <p class="mt-2 text-xl font-semibold text-base-content">
          <%= if @order_plan.budget do %>
            {Decimal.to_string(@order_plan.budget, :normal)} {@order_plan.base_currency}
          <% else %>
            Not defined
          <% end %>
        </p>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-base-content/60">
          Allocated
        </p>

        <p class="mt-2 text-xl font-semibold text-base-content/60">
          Not available yet
        </p>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-base-content/60">
          Remaining
        </p>

        <p class="mt-2 text-xl font-semibold text-base-content/60">
          Not available yet
        </p>
      </div>
    </section>

    <section class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
      <div class="space-y-4">
        <div>
          <h2 class="text-xl font-semibold text-base-content">
            Order lists
          </h2>

          <p class="text-sm text-base-content/60">
            Concrete acquisition lists belonging to this plan.
          </p>
        </div>

        <div
          :if={@order_plan.order_lists == []}
          id="empty-order-lists"
          class="rounded-box border border-dashed border-base-300 bg-base-100 p-8 text-center"
        >
          <p class="font-medium text-base-content">
            No order lists yet.
          </p>

          <p class="mt-1 text-sm text-base-content/60">
            Create the first order list for this acquisition plan.
          </p>
        </div>

        <div
          :if={@order_plan.order_lists != []}
          id="order-lists"
          class="grid gap-4"
        >
          <article
            :for={order_list <- @order_plan.order_lists}
            id={"order-list-#{order_list.id}"}
            class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm"
          >
            <h3 class="font-semibold text-base-content">
              {order_list.name}
            </h3>
          </article>
        </div>
      </div>

      <aside class="rounded-box border border-base-300 bg-base-200 p-6">
        <h2 class="text-lg font-semibold text-base-content">
          New order list
        </h2>

        <p class="mt-1 text-sm leading-6 text-base-content/60">
          Create a concrete list within this acquisition plan.
        </p>

        <.form
          for={@form}
          id="order-list-form"
          phx-change="validate"
          phx-submit="save"
          class="mt-6 space-y-5"
        >
          <.input
            field={@form[:name]}
            type="text"
            label="Name"
            placeholder="Myanmar 2026-1"
            autocomplete="off"
          />

          <.button class="btn btn-primary w-full">
            Create order list
          </.button>
        </.form>
      </aside>
    </section>
  </div>
</Layouts.app>
